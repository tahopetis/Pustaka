	return &rt, nil
}

// ListRelationshipTypes retrieves paginated relationship types with filters
func (r *RelationshipTypeRepository) ListRelationshipTypes(ctx context.Context, filter RelationshipTypeFilter, page, limit int) (*RelationshipTypeListResponse, error) {
	offset := (page - 1) * limit

	// Build WHERE clause
	whereClause := "WHERE 1=1"
	args := []interface{}{}
	argIndex := 1

	if filter.Category != "" {
		whereClause += fmt.Sprintf(" AND category = $%d", argIndex)
		args = append(args, filter.Category)
		argIndex++
	}

	if filter.IsActive != nil {
		whereClause += fmt.Sprintf(" AND is_active = $%d", argIndex)
		args = append(args, *filter.IsActive)
		argIndex++
	}

	if filter.IsSystem != nil {
		whereClause += fmt.Sprintf(" AND is_system = $%d", argIndex)
		args = append(args, *filter.IsSystem)
		argIndex++
	}

	if filter.Search != "" {
		whereClause += fmt.Sprintf(" AND (name ILIKE $%d OR display_name ILIKE $%d OR description ILIKE $%d)", argIndex, argIndex+1, argIndex+2)
		args = append(args, "%"+filter.Search+"%", "%"+filter.Search+"%", "%"+filter.Search+"%")
		argIndex += 3
	}

	// Build ORDER BY clause
	orderBy := "ORDER BY name ASC"
	if filter.Sort != "" {
		orderField := filter.Sort
		allowedFields := map[string]bool{
			"name": true, "display_name": true, "category": true,
			"created_at": true, "updated_at": true,
		}
		if allowedFields[orderField] {
			orderDirection := "ASC"
			if filter.Order == "desc" {
				orderDirection = "DESC"
			}
			orderBy = fmt.Sprintf("ORDER BY %s %s", orderField, orderDirection)
		}
	}

	// Get total count
	countQuery := fmt.Sprintf("SELECT COUNT(*) FROM relationship_types %s", whereClause)
	var total int64
	err := r.db.QueryRow(ctx, countQuery, args...).Scan(&total)
	if err != nil {
		r.logger.ErrorDatabase("SELECT", "relationship_types", err, nil)
		return nil, fmt.Errorf("failed to count relationship types: %w", err)
	}

	// Get paginated results
	query := fmt.Sprintf(`
		SELECT id, name, display_name, description, category, forward_label, backward_label,
			is_active, is_system, cardinality, allowed_source_types, allowed_target_types,
			attributes_schema, created_at, updated_at, created_by, updated_by
		FROM relationship_types %s %s
		LIMIT $%d OFFSET $%d
	`, whereClause, orderBy, argIndex, argIndex+1)

	args = append(args, limit, offset)

	rows, err := r.db.Query(ctx, query, args...)
	if err != nil {
		r.logger.ErrorDatabase("SELECT", "relationship_types", err, nil)
		return nil, fmt.Errorf("failed to list relationship types: %w", err)
	}
	defer rows.Close()

	var relationshipTypes []RelationshipType
	for rows.Next() {
		var rt RelationshipType
		err := rows.Scan(
			&rt.ID,
			&rt.Name,
			&rt.DisplayName,
			&rt.Description,
			&rt.Category,
			&rt.ForwardLabel,
			&rt.BackwardLabel,
			&rt.IsActive,
			&rt.IsSystem,
			&rt.Cardinality,
			&rt.AllowedSourceTypes,
			&rt.AllowedTargetTypes,
			&rt.AttributesSchema,
			&rt.CreatedAt,
			&rt.UpdatedAt,
			&rt.CreatedBy,
			&rt.UpdatedBy,
		)
		if err != nil {
			r.logger.ErrorDatabase("SCAN", "relationship_types", err, nil)
			return nil, fmt.Errorf("failed to scan relationship type: %w", err)
		}
		relationshipTypes = append(relationshipTypes, rt)
	}

	totalPages := int((total + int64(limit) - 1) / int64(limit))

	return &RelationshipTypeListResponse{
		RelationshipTypes: relationshipTypes,
		Page:              page,
		Limit:             limit,
		Total:             total,
		TotalPages:        totalPages,
	}, nil
}

// UpdateRelationshipType updates an existing relationship type
func (r *RelationshipTypeRepository) UpdateRelationshipType(ctx context.Context, id uuid.UUID, req *UpdateRelationshipTypeRequest, updatedBy uuid.UUID) (*RelationshipType, error) {
	// Get current relationship type
	current, err := r.GetRelationshipType(ctx, id)
	if err != nil {
		return nil, err
	}

	// Check if it's a system type that shouldn't be modified
	if current.IsSystem {
		return nil, fmt.Errorf("system relationship types cannot be modified")
	}

	// Build dynamic UPDATE query
	query := "UPDATE relationship_types SET updated_at = $1, updated_by = $2"
	args := []interface{}{time.Now(), updatedBy}
	argIndex := 3

	if req.DisplayName != nil {
		query += fmt.Sprintf(", display_name = $%d", argIndex)
		args = append(args, *req.DisplayName)
		argIndex++
	}
	if req.Description != nil {
		query += fmt.Sprintf(", description = $%d", argIndex)
		args = append(args, *req.Description)
		argIndex++
	}
	if req.Category != nil {
		query += fmt.Sprintf(", category = $%d", argIndex)
		args = append(args, *req.Category)
		argIndex++
	}
	if req.ForwardLabel != nil {
		query += fmt.Sprintf(", forward_label = $%d", argIndex)
		args = append(args, *req.ForwardLabel)
		argIndex++
	}
	if req.BackwardLabel != nil {
		query += fmt.Sprintf(", backward_label = $%d", argIndex)
		args = append(args, *req.BackwardLabel)
		argIndex++
	}
	if req.IsActive != nil {
		query += fmt.Sprintf(", is_active = $%d", argIndex)
		args = append(args, *req.IsActive)
		argIndex++
	}
	if req.Cardinality != nil {
		query += fmt.Sprintf(", cardinality = $%d", argIndex)
		args = append(args, *req.Cardinality)
		argIndex++
	}
	if req.AllowedSourceTypes != nil {
		query += fmt.Sprintf(", allowed_source_types = $%d", argIndex)
		args = append(args, req.AllowedSourceTypes)
		argIndex++
	}
	if req.AllowedTargetTypes != nil {
		query += fmt.Sprintf(", allowed_target_types = $%d", argIndex)
		args = append(args, req.AllowedTargetTypes)
		argIndex++
	}
	if req.AttributesSchema != nil {
		attributesSchema := map[string]interface{}{
			"attributes": req.AttributesSchema,
		}
		query += fmt.Sprintf(", attributes_schema = $%d", argIndex)
		args = append(args, attributesSchema)
		argIndex++
	}

	query += fmt.Sprintf(" WHERE id = $%d RETURNING *", argIndex)
	args = append(args, id)

	var result RelationshipType
	err = r.db.QueryRow(ctx, query, args...).Scan(
		&result.ID,
		&result.Name,
		&result.DisplayName,
		&result.Description,
		&result.Category,
		&result.ForwardLabel,
		&result.BackwardLabel,
		&result.IsActive,
		&result.IsSystem,
		&result.Cardinality,
		&result.AllowedSourceTypes,
		&result.AllowedTargetTypes,
		&result.AttributesSchema,
		&result.CreatedAt,
		&result.UpdatedAt,
		&result.CreatedBy,
		&result.UpdatedBy,
	)

	if err != nil {
		r.logger.ErrorDatabase("UPDATE", "relationship_types", err, map[string]interface{}{
			"id": id,
		})
		return nil, fmt.Errorf("failed to update relationship type: %w", err)
	}

	r.logger.InfoDatabase("UPDATE", "relationship_types", 0, map[string]interface{}{
		"id":   result.ID,
		"name": result.Name,
	})

	return &result, nil
}

// DeleteRelationshipType deletes a relationship type
func (r *RelationshipTypeRepository) DeleteRelationshipType(ctx context.Context, id uuid.UUID) error {
	// Get relationship type for logging and validation
	rt, err := r.GetRelationshipType(ctx, id)
	if err != nil {
		return err
	}

	// Check if it's a system type
	if rt.IsSystem {
		return fmt.Errorf("system relationship types cannot be deleted")
	}

	// Check if there are any existing relationships using this type
	var relationshipCount int64
	countQuery := "SELECT COUNT(*) FROM relationships WHERE relationship_type = $1"
	err = r.db.QueryRow(ctx, countQuery, rt.Name).Scan(&relationshipCount)
	if err != nil {
		r.logger.ErrorDatabase("SELECT", "relationships", err, map[string]interface{}{
			"relationship_type": rt.Name,
		})
		return fmt.Errorf("failed to check for existing relationships: %w", err)
	}

	if relationshipCount > 0 {
		return fmt.Errorf("cannot delete relationship type with existing relationships")
	}

	// Delete the relationship type
	query := "DELETE FROM relationship_types WHERE id = $1"
	cmdTag, err := r.db.Exec(ctx, query, id)
	if err != nil {
		r.logger.ErrorDatabase("DELETE", "relationship_types", err, map[string]interface{}{
			"id": id,
		})
		return fmt.Errorf("failed to delete relationship type: %w", err)
	}

	if cmdTag.RowsAffected() == 0 {
		return fmt.Errorf("relationship type not found")
	}

	r.logger.InfoDatabase("DELETE", "relationship_types", 0, map[string]interface{}{
		"id":   id,
		"name": rt.Name,
	})

	return nil
}

// GetActiveRelationshipTypes returns all active relationship types
func (r *RelationshipTypeRepository) GetActiveRelationshipTypes(ctx context.Context) ([]RelationshipType, error) {
	query := `
		SELECT id, name, display_name, description, category, forward_label, backward_label,
			is_active, is_system, cardinality, allowed_source_types, allowed_target_types,
			attributes_schema, created_at, updated_at, created_by, updated_by
		FROM relationship_types
		WHERE is_active = true
		ORDER BY name ASC
	`

	rows, err := r.db.Query(ctx, query)
	if err != nil {
		r.logger.ErrorDatabase("SELECT", "relationship_types", err, nil)
		return nil, fmt.Errorf("failed to get active relationship types: %w", err)
	}
	defer rows.Close()

	var relationshipTypes []RelationshipType
	for rows.Next() {
		var rt RelationshipType
		err := rows.Scan(
			&rt.ID,
			&rt.Name,
			&rt.DisplayName,
			&rt.Description,
			&rt.Category,
			&rt.ForwardLabel,
			&rt.BackwardLabel,
			&rt.IsActive,
			&rt.IsSystem,
			&rt.Cardinality,
			&rt.AllowedSourceTypes,
			&rt.AllowedTargetTypes,
			&rt.AttributesSchema,
			&rt.CreatedAt,
			&rt.UpdatedAt,
			&rt.CreatedBy,
			&rt.UpdatedBy,
		)
		if err != nil {
			r.logger.ErrorDatabase("SCAN", "relationship_types", err, nil)
			return nil, fmt.Errorf("failed to scan relationship type: %w", err)
		}
		relationshipTypes = append(relationshipTypes, rt)
	}

	return relationshipTypes, nil
}

// GetRelationshipTypeUsage returns usage statistics for relationship types
func (r *RelationshipTypeRepository) GetRelationshipTypeUsage(ctx context.Context) ([]RelationshipTypeUsage, error) {
	query := `
		SELECT
			rt.name,
			rt.display_name,
			COUNT(r.id) as relationship_count
		FROM relationship_types rt
		LEFT JOIN relationships r ON rt.name = r.relationship_type
		WHERE rt.is_active = true
		GROUP BY rt.id, rt.name, rt.display_name
		ORDER BY relationship_count DESC, rt.name ASC
	`

	rows, err := r.db.Query(ctx, query)
	if err != nil {
		r.logger.ErrorDatabase("SELECT", "relationship_types", err, nil)
		return nil, fmt.Errorf("failed to get relationship type usage: %w", err)
	}
	defer rows.Close()

	var usage []RelationshipTypeUsage
	for rows.Next() {
		var u RelationshipTypeUsage
		err := rows.Scan(
			&u.Name,
			&u.DisplayName,
			&u.RelationshipCount,
		)
		if err != nil {
			r.logger.ErrorDatabase("SCAN", "relationship_types", err, nil)
			return nil, fmt.Errorf("failed to scan relationship type usage: %w", err)
		}
		usage = append(usage, u)
	}

	return usage, nil
}

// GetRelationshipTypeStatistics returns comprehensive statistics
func (r *RelationshipTypeRepository) GetRelationshipTypeStatistics(ctx context.Context) (*RelationshipTypeStatistics, error) {
	stats := &RelationshipTypeStatistics{
		Categories:            make(map[string]int64),
		CardinalityDistribution: make(map[string]int64),
	}

	// Get basic counts
	countQueries := map[string]*int64{
		"total":  &stats.TotalTypes,
		"active": &stats.ActiveTypes,
		"system": &stats.SystemTypes,
	}

	for name, ptr := range countQueries {
		query := fmt.Sprintf("SELECT COUNT(*) FROM relationship_types WHERE is_active = true")
		if name == "active" {
			query = "SELECT COUNT(*) FROM relationship_types WHERE is_active = true"
		} else if name == "system" {
			query = "SELECT COUNT(*) FROM relationship_types WHERE is_system = true"
		}

		err := r.db.QueryRow(ctx, query).Scan(ptr)
		if err != nil {
			r.logger.ErrorDatabase("SELECT", "relationship_types", err, nil)
			return nil, fmt.Errorf("failed to get %s count: %w", name, err)
		}
	}

	stats.CustomTypes = stats.TotalTypes - stats.SystemTypes

	// Get category distribution
	categoryQuery := `
		SELECT category, COUNT(*)
		FROM relationship_types
		WHERE is_active = true
		GROUP BY category
		ORDER BY COUNT(*) DESC
	`
	rows, err := r.db.Query(ctx, categoryQuery)
	if err != nil {
		r.logger.ErrorDatabase("SELECT", "relationship_types", err, nil)
		return nil, fmt.Errorf("failed to get category distribution: %w", err)
	}
	defer rows.Close()

	for rows.Next() {
		var category string
		var count int64
		err := rows.Scan(&category, &count)
		if err != nil {
			r.logger.ErrorDatabase("SCAN", "relationship_types", err, nil)
			return nil, fmt.Errorf("failed to scan category distribution: %w", err)
		}
		stats.Categories[category] = count
	}

	// Get cardinality distribution
	cardinalityQuery := `
		SELECT cardinality, COUNT(*)
		FROM relationship_types
		WHERE is_active = true
		GROUP BY cardinality
		ORDER BY COUNT(*) DESC
	`
	rows, err = r.db.Query(ctx, cardinalityQuery)
	if err != nil {
		r.logger.ErrorDatabase("SELECT", "relationship_types", err, nil)
		return nil, fmt.Errorf("failed to get cardinality distribution: %w", err)
	}
	defer rows.Close()

	for rows.Next() {
		var cardinality string
		var count int64
		err := rows.Scan(&cardinality, &count)
		if err != nil {
			r.logger.ErrorDatabase("SCAN", "relationship_types", err, nil)
			return nil, fmt.Errorf("failed to scan cardinality distribution: %w", err)
		}
		stats.CardinalityDistribution[cardinality] = count
	}

	// Get most used types (top 10)
	mostUsedQuery := `
		SELECT
			rt.name,
			rt.display_name,
			COUNT(r.id) as relationship_count
		FROM relationship_types rt
		LEFT JOIN relationships r ON rt.name = r.relationship_type
		WHERE rt.is_active = true
		GROUP BY rt.id, rt.name, rt.display_name
		HAVING COUNT(r.id) > 0
		ORDER BY relationship_count DESC
		LIMIT 10
	`
	rows, err = r.db.Query(ctx, mostUsedQuery)
	if err != nil {
		r.logger.ErrorDatabase("SELECT", "relationship_types", err, nil)
		return nil, fmt.Errorf("failed to get most used types: %w", err)
	}
	defer rows.Close()

	for rows.Next() {
		var usage RelationshipTypeUsage
		err := rows.Scan(
			&usage.Name,
			&usage.DisplayName,
			&usage.RelationshipCount,
		)
		if err != nil {
			r.logger.ErrorDatabase("SCAN", "relationship_types", err, nil)
			return nil, fmt.Errorf("failed to scan most used type: %w", err)
		}
		stats.MostUsedTypes = append(stats.MostUsedTypes, usage)
	}

	// Get unused types
	unusedQuery := `
		SELECT
			id, name, display_name, category, forward_label, backward_label, is_active, is_system
		FROM relationship_types rt
		WHERE rt.is_active = true
		AND NOT EXISTS (
			SELECT 1 FROM relationships r WHERE r.relationship_type = rt.name
		)
		ORDER BY rt.name ASC
	`
	rows, err = r.db.Query(ctx, unusedQuery)
	if err != nil {
		r.logger.ErrorDatabase("SELECT", "relationship_types", err, nil)
		return nil, fmt.Errorf("failed to get unused types: %w", err)
	}
	defer rows.Close()

	for rows.Next() {
		var summary RelationshipTypeSummary
		err := rows.Scan(
			&summary.Name,
			&summary.DisplayName,
			&summary.Category,
			&summary.ForwardLabel,
			&summary.BackwardLabel,
			&summary.IsActive,
			&summary.IsSystem,
		)
		if err != nil {
			r.logger.ErrorDatabase("SCAN", "relationship_types", err, nil)
			return nil, fmt.Errorf("failed to scan unused type: %w", err)
		}
		stats.UnusedTypes = append(stats.UnusedTypes, summary)
	}

	return stats, nil
}