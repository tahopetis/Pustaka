		&rt.ForwardLabel,
		&rt.BackwardLabel,
		&rt.IsActive,
		&rt.IsSystem,
		&rt.Cardinality,
		&rt.AllowedSourceTypes,
		&rt.AllowedTargetTypes,
		&rt.AttributesSchema,
		&rt.CreatedAt,
		&rt.UpdatedAt,
		&rt.CreatedBy,
		&rt.UpdatedBy,
	)

	if err != nil {
