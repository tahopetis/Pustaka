package ci

import (
	"context"
	"fmt"

	"github.com/google/uuid"
)

// RelationshipServiceIntegration integrates relationship types with the existing relationship service
type RelationshipServiceIntegration struct {
	relationshipTypeService *RelationshipTypeService
	neo4jIntegration        *RelationshipTypesNeo4jIntegration
}

func NewRelationshipServiceIntegration(
	relationshipTypeService *RelationshipTypeService,
	neo4jIntegration *RelationshipTypesNeo4jIntegration,
) *RelationshipServiceIntegration {
	return &RelationshipServiceIntegration{
		relationshipTypeService: relationshipTypeService,
		neo4jIntegration:        neo4jIntegration,
	}
}

// Enhanced CreateRelationship that validates against relationship types
func (i *RelationshipServiceIntegration) CreateRelationshipWithValidation(ctx context.Context, req *CreateRelationshipRequest, userID uuid.UUID) (*Relationship, error) {
	// Get relationship type
	rt, err := i.relationshipTypeService.GetRelationshipTypeByName(ctx, req.RelationshipType)
	if err != nil {
		return nil, fmt.Errorf("relationship type '%s' not found: %w", req.RelationshipType, err)
	}

	// Check if relationship type is active
	if !rt.IsActive {
		return nil, fmt.Errorf("relationship type '%s' is not active", req.RelationshipType)
	}

	// Validate relationship against type constraints
	validation, err := i.relationshipTypeService.ValidateRelationship(ctx, req.RelationshipType, req.SourceID, req.TargetID)
	if err != nil {
		return nil, fmt.Errorf("relationship validation failed: %w", err)
	}

	if !validation.IsValid {
		return nil, fmt.Errorf("relationship validation failed: %v", validation.Errors)
	}

	// Log warnings if any
	if len(validation.Warnings) > 0 {
		// In a real implementation, you might want to handle warnings differently
		fmt.Printf("Relationship validation warnings: %v\n", validation.Warnings)
	}

	// Validate attributes against relationship type schema if defined
	if err := i.validateRelationshipAttributes(req.Attributes, rt); err != nil {
		return nil, fmt.Errorf("attribute validation failed: %w", err)
	}

	// Create the relationship (this would call the existing relationship service)
	relationship := &Relationship{
		SourceID:        req.SourceID,
		TargetID:        req.TargetID,
		RelationshipType: req.RelationshipType,
		Attributes:      req.Attributes,
		CreatedBy:       userID,
	}

	// Sync to Neo4j with enhanced validation
	if i.neo4jIntegration != nil {
		// Note: You would need to fetch the actual CIs for this call
		// This is a simplified example
		err = i.neo4jIntegration.CreateRelationshipWithValidation(ctx, rt, relationship, nil, nil)
		if err != nil {
			return nil, fmt.Errorf("failed to sync to Neo4j: %w", err)
		}
	}

	return relationship, nil
}

// GetRelationshipTypeForRelationship gets the relationship type definition for a relationship
func (i *RelationshipServiceIntegration) GetRelationshipTypeForRelationship(ctx context.Context, relationship *Relationship) (*RelationshipType, error) {
	return i.relationshipTypeService.GetRelationshipTypeByName(ctx, relationship.RelationshipType)
}

// GetRelationshipLabel gets the appropriate label for a relationship
func (i *RelationshipServiceIntegration) GetRelationshipLabel(ctx context.Context, relationship *Relationship, isForward bool, sourceCI, targetCI *ConfigurationItem) (string, error) {
	rt, err := i.GetRelationshipTypeForRelationship(ctx, relationship)
	if err != nil {
		return "", err
	}

	return rt.GetLabel(isForward, sourceCI, targetCI), nil
}

// GetAvailableRelationshipTypesForCI gets relationship types that can be used with a specific CI
func (i *RelationshipServiceIntegration) GetAvailableRelationshipTypesForCI(ctx context.Context, ci *ConfigurationItem) ([]RelationshipType, error) {
	// Get all active relationship types
	allTypes, err := i.relationshipTypeService.GetActiveRelationshipTypes(ctx)
	if err != nil {
		return nil, err
	}

	var availableTypes []RelationshipType
	for _, rt := range allTypes {
		// Check if CI type is in allowed source types
		if len(rt.AllowedSourceTypes) > 0 {
			allowed := false
			for _, allowedType := range rt.AllowedSourceTypes {
				if ci.CIType == allowedType {
					allowed = true
					break
				}
			}
			if !allowed {
				continue
			}
		}

		// Check if CI type is in allowed target types
		if len(rt.AllowedTargetTypes) > 0 {
			allowed := false
			for _, allowedType := range rt.AllowedTargetTypes {
				if ci.CIType == allowedType {
					allowed = true
					break
				}
			}
			if !allowed {
				continue
			}
		}

		availableTypes = append(availableTypes, rt)
	}

	return availableTypes, nil
}

// GetCompatibleRelationshipTypes gets relationship types that can be used between two CIs
func (i *RelationshipServiceIntegration) GetCompatibleRelationshipTypes(ctx context.Context, sourceCI, targetCI *ConfigurationItem) ([]RelationshipType, error) {
	// Get all active relationship types
	allTypes, err := i.relationshipTypeService.GetActiveRelationshipTypes(ctx)
	if err != nil {
		return nil, err
	}

	var compatibleTypes []RelationshipType
	for _, rt := range allTypes {
		// Check source CI compatibility
		if len(rt.AllowedSourceTypes) > 0 {
			allowed := false
			for _, allowedType := range rt.AllowedSourceTypes {
				if sourceCI.CIType == allowedType {
					allowed = true
					break
				}
			}
			if !allowed {
				continue
			}
		}

		// Check target CI compatibility
		if len(rt.AllowedTargetTypes) > 0 {
			allowed := false
			for _, allowedType := range rt.AllowedTargetTypes {
				if targetCI.CIType == allowedType {
					allowed = true
					break
				}
			}
			if !allowed {
				continue
			}
		}

		compatibleTypes = append(compatibleTypes, rt)
	}

	return compatibleTypes, nil
}

