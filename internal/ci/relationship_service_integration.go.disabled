	for key, value := range attributes {
		switch value.(type) {
		case string, int, int64, float64, bool:
			// Valid types
		case map[string]interface{}, []interface{}:
			// Complex types - could be validated further
		default:
			return fmt.Errorf("attribute '%s' has invalid type", key)
		}
	}

	return nil
}

func validateAttributeType(name string, value interface{}, expectedType string) error {
	switch expectedType {
	case "string":
		if _, ok := value.(string); !ok {
			return fmt.Errorf("attribute '%s' must be a string", name)
		}
	case "integer":
		if _, ok := value.(int); !ok {
			if _, ok := value.(float64); !ok {
				return fmt.Errorf("attribute '%s' must be an integer", name)
			}
		}
	case "boolean":
		if _, ok := value.(bool); !ok {
			return fmt.Errorf("attribute '%s' must be a boolean", name)
		}
	case "array":
		if _, ok := value.([]interface{}); !ok {
			return fmt.Errorf("attribute '%s' must be an array", name)
		}
	case "object":
		if _, ok := value.(map[string]interface{}); !ok {
			return fmt.Errorf("attribute '%s' must be an object", name)
		}
	default:
		return fmt.Errorf("unknown attribute type '%s' for attribute '%s'", expectedType, name)
	}

	return nil
}

func validateAttributeValue(schemaAttr RelationshipTypeAttributeSchema, value interface{}) error {
	if schemaAttr.Validation == nil {
		return nil
	}

	validation := schemaAttr.Validation

	// String validations
	if strValue, ok := value.(string); ok {
		if validation.MinLength != nil && len(strValue) < *validation.MinLength {
			return fmt.Errorf("attribute '%s' minimum length is %d", schemaAttr.Name, *validation.MinLength)
		}
		if validation.MaxLength != nil && len(strValue) > *validation.MaxLength {
			return fmt.Errorf("attribute '%s' maximum length is %d", schemaAttr.Name, *validation.MaxLength)
		}
	}

	// Integer validations
	if intValue, ok := value.(int); ok {
		if validation.Min != nil && intValue < *validation.Min {
			return fmt.Errorf("attribute '%s' minimum value is %d", schemaAttr.Name, *validation.Min)
		}
		if validation.Max != nil && intValue > *validation.Max {
			return fmt.Errorf("attribute '%s' maximum value is %d", schemaAttr.Name, *validation.Max)
		}
	}

	// Array validations
	if arrayValue, ok := value.([]interface{}); ok {
		if validation.MinLength != nil && len(arrayValue) < *validation.MinLength {
			return fmt.Errorf("attribute '%s' must have at least %d items", schemaAttr.Name, *validation.MinLength)
		}
		if validation.MaxLength != nil && len(arrayValue) > *validation.MaxLength {
			return fmt.Errorf("attribute '%s' must have at most %d items", schemaAttr.Name, *validation.MaxLength)
		}
	}

	return nil
}