package ci

import (
	"context"
	"fmt"
	"strings"
	"time"

	"github.com/google/uuid"
	"github.com/neo4j/neo4j-go-driver/v5/neo4j"
	pustakaLogger "github.com/pustaka/pustaka/pkg/logger"
)

// RelationshipTypesNeo4jIntegration handles Neo4j integration for relationship types
type RelationshipTypesNeo4jIntegration struct {
	driver        neo4j.DriverWithContext
	logger        *pustakaLogger.Logger
	cacheEnabled  bool
	cacheExpiry   time.Duration
}

func NewRelationshipTypesNeo4jIntegration(driver neo4j.DriverWithContext, logger *pustakaLogger.Logger) *RelationshipTypesNeo4jIntegration {
	return &RelationshipTypesNeo4jIntegration{
		driver:       driver,
		logger:       logger,
		cacheEnabled: true,
		cacheExpiry:  5 * time.Minute,
	}
}

// SyncRelationshipTypeToNeo4j syncs a relationship type definition to Neo4j
func (n *RelationshipTypesNeo4jIntegration) SyncRelationshipTypeToNeo4j(ctx context.Context, rt *RelationshipType) error {
	session := n.driver.NewSession(ctx, neo4j.SessionConfig{AccessMode: neo4j.AccessModeWrite})
	defer session.Close(ctx)

	// Create or update relationship type metadata in Neo4j
	query := `
		MERGE (rt:RelationshipType {name: $name})
		SET rt.display_name = $display_name,
			rt.description = $description,
			rt.category = $category,
			rt.forward_label = $forward_label,
			rt.backward_label = $backward_label,
			rt.is_active = $is_active,
			rt.is_system = $is_system,
			rt.cardinality = $cardinality,
			rt.allowed_source_types = $allowed_source_types,
			rt.allowed_target_types = $allowed_target_types,
			rt.updated_at = datetime($updated_at)
		RETURN rt
	`

	params := map[string]interface{}{
		"name":                rt.Name,
		"display_name":        rt.DisplayName,
		"description":         rt.Description,
		"category":            rt.Category,
		"reverse_label":       rt.ReverseLabel,
		"is_active":           rt.IsActive,
		"is_system_type":      rt.IsSystemType,
		"cardinality_source":  rt.CardinalitySource,
		"cardinality_target":  rt.CardinalityTarget,
		"bidirectional":       rt.Bidirectional,
		"allowed_source_types": rt.AllowedSourceTypes,
		"allowed_target_types": rt.AllowedTargetTypes,
		"updated_at":          time.Now(),
	}

	_, err := session.Run(ctx, query, params)
	if err != nil {
		n.logger.ErrorService("neo4j", "sync_relationship_type", err, map[string]interface{}{
			"relationship_type": rt.Name,
		})
		return fmt.Errorf("failed to sync relationship type to Neo4j: %w", err)
	}

	// Create constraints for better performance
	n.createRelationshipTypeConstraints(ctx, rt.Name)

	n.logger.InfoService("neo4j", "sync_relationship_type", map[string]interface{}{
		"relationship_type": rt.Name,
	})

	return nil
}

// ValidateRelationshipInNeo4j validates a relationship against Neo4j constraints
func (n *RelationshipTypesNeo4jIntegration) ValidateRelationshipInNeo4j(ctx context.Context, rt *RelationshipType, sourceID, targetID uuid.UUID) (*RelationshipTypeValidation, error) {
	session := n.driver.NewSession(ctx, neo4j.SessionConfig{AccessMode: neo4j.AccessModeRead})
	defer session.Close(ctx)

	validation := &RelationshipTypeValidation{
		IsValid: true,
		Errors:  []string{},
		Warnings: []string{},
	}

	// Check for existing relationships
	relationshipCheckQuery := `
		MATCH (source:ConfigurationItem {id: $source_id})-[r]->(target:ConfigurationItem {id: $target_id})
		WHERE type(r) = $relationship_type
		RETURN count(r) as relationship_count
	`

	params := map[string]interface{}{
		"source_id":         sourceID.String(),
		"target_id":         targetID.String(),
		"relationship_type": rt.Name,
	}

	result, err := session.Run(ctx, relationshipCheckQuery, params)
	if err != nil {
		return nil, fmt.Errorf("failed to check existing relationships: %w", err)
	}

	if result.Next(ctx) {
		relationshipCount, _ := result.Record().Get("relationship_count")
		if count, ok := relationshipCount.(int64); ok && count > 0 {
			validation.IsValid = false
			validation.Errors = append(validation.Errors, "Relationship already exists between these CIs")
		}
	}

	// Check cardinality constraints based on relationship type
	cardinality := rt.CardinalitySource + "-to-" + rt.CardinalityTarget
	if cardinality == "one-to-one" || cardinality == "one-to-many" {
		// Check if source CI already has this relationship type
		sourceCheckQuery := `
			MATCH (source:ConfigurationItem {id: $source_id})-[r:%s]->()
			RETURN count(r) as source_count
		`

		formattedQuery := fmt.Sprintf(sourceCheckQuery, strings.ToUpper(rt.Name))
		sourceParams := map[string]interface{}{
			"source_id": sourceID.String(),
		}

		sourceResult, err := session.Run(ctx, formattedQuery, sourceParams)
		if err != nil {
			return nil, fmt.Errorf("failed to check source cardinality: %w", err)
		}

		if sourceResult.Next(ctx) {
			sourceCount, _ := sourceResult.Record().Get("source_count")
			if count, ok := sourceCount.(int64); ok && count > 0 {
				if cardinality == "one-to-one" {
					validation.IsValid = false
					validation.Errors = append(validation.Errors, "Source CI already has a one-to-one relationship of this type")
				}
			}
		}
	}

	// Check for circular dependencies in dependency relationships
	if rt.Name == "depends_on" || rt.Name == "part_of" {
		if err := n.checkCircularDependencyInNeo4j(ctx, rt.Name, sourceID, targetID, validation); err != nil {
			return nil, err
		}
	}

	return validation, nil
}

// GetRelationshipTypeUsageFromNeo4j gets usage statistics from Neo4j
func (n *RelationshipTypesNeo4jIntegration) GetRelationshipTypeUsageFromNeo4j(ctx context.Context) ([]RelationshipTypeUsage, error) {
	session := n.driver.NewSession(ctx, neo4j.SessionConfig{AccessMode: neo4j.AccessModeRead})
	defer session.Close(ctx)

	query := `
		MATCH (rt:RelationshipType)
		OPTIONAL MATCH (ci1:ConfigurationItem)-[r]->(ci2:ConfigurationItem)
		WHERE type(r) = rt.name
		RETURN rt.name as name,
		       rt.display_name as display_name,
		       count(r) as relationship_count
		ORDER BY relationship_count DESC, rt.name ASC
	`

	result, err := session.Run(ctx, query, map[string]interface{}{})
	if err != nil {
		return nil, fmt.Errorf("failed to get relationship type usage from Neo4j: %w", err)
	}

	var usage []RelationshipTypeUsage
	for result.Next(ctx) {
		record := result.Record()
		name, _ := record.Get("name")
		displayName, _ := record.Get("display_name")
		count, _ := record.Get("relationship_count")

		usage = append(usage, RelationshipTypeUsage{
			Name:            name.(string),
			DisplayName:     displayName.(string),
			RelationshipCount: count.(int64),
		})
	}

	return usage, nil
}

// FindCircularDependencies finds circular dependencies in Neo4j
func (n *RelationshipTypesNeo4jIntegration) FindCircularDependencies(ctx context.Context, relationshipType string) ([][]uuid.UUID, error) {
	session := n.driver.NewSession(ctx, neo4j.SessionConfig{AccessMode: neo4j.AccessModeRead})
	defer session.Close(ctx)

	// Use Neo4j's path finding to detect cycles
	query := `
		MATCH path = (ci1:ConfigurationItem)-[%s*]->(ci1)
		WHERE ci1.id = ci1.id AND length(path) > 0
		RETURN [node IN nodes(path) | node.id] as cycle_ids
		ORDER BY length(path) ASC
	`

	formattedQuery := fmt.Sprintf(query, strings.ToUpper(relationshipType))
	result, err := session.Run(ctx, formattedQuery, map[string]interface{}{})
	if err != nil {
		return nil, fmt.Errorf("failed to find circular dependencies: %w", err)
	}

	var cycles [][]uuid.UUID
	for result.Next(ctx) {
		record := result.Record()
		cycleIDs, _ := record.Get("cycle_ids")

		if cycleIDsSlice, ok := cycleIDs.([]interface{}); ok {
			var cycle []uuid.UUID
			for _, id := range cycleIDsSlice {
				if idStr, ok := id.(string); ok {
					if uuid, err := uuid.Parse(idStr); err == nil {
						cycle = append(cycle, uuid)
					}
				}
			}
			if len(cycle) > 0 {
				cycles = append(cycles, cycle)
			}
		}
	}

	return cycles, nil
}

// CreateRelationshipWithValidation creates a relationship in Neo4j with validation
func (n *RelationshipTypesNeo4jIntegration) CreateRelationshipWithValidation(ctx context.Context, rt *RelationshipType, relationship *Relationship, sourceCI, targetCI *ConfigurationItem) error {
	session := n.driver.NewSession(ctx, neo4j.SessionConfig{AccessMode: neo4j.AccessModeWrite})
	defer session.Close(ctx)

	// Validate relationship type compatibility
	validation, err := n.ValidateRelationshipInNeo4j(ctx, rt, sourceCI.ID, targetCI.ID)
	if err != nil {
		return err
	}

	if !validation.IsValid {
		return fmt.Errorf("relationship validation failed: %v", validation.Errors)
	}

	// Create the relationship in Neo4j
	query := `
		MATCH (source:ConfigurationItem {id: $source_id})
		MATCH (target:ConfigurationItem {id: $target_id})
		CREATE (source)-[r:%s {
			id: $relationship_id,
			relationship_type: $relationship_type,
			attributes: $attributes,
			created_at: datetime($created_at),
			created_by: $created_by
		}]->(target)
		RETURN r
	`

	formattedQuery := fmt.Sprintf(query, strings.ToUpper(rt.Name))
	params := map[string]interface{}{
		"source_id":         sourceCI.ID.String(),
		"target_id":         targetCI.ID.String(),
		"relationship_id":   relationship.ID.String(),
		"relationship_type": relationship.RelationshipType,
		"attributes":        relationship.Attributes,
		"created_at":        relationship.CreatedAt,
		"created_by":        relationship.CreatedBy.String(),
	}

	_, err = session.Run(ctx, formattedQuery, params)
	if err != nil {
		n.logger.ErrorService("neo4j", "create_relationship_with_validation", err, map[string]interface{}{
			"relationship_id":   relationship.ID,
			"relationship_type": relationship.RelationshipType,
		})
		return fmt.Errorf("failed to create relationship in Neo4j: %w", err)
	}

	n.logger.InfoService("neo4j", "create_relationship_with_validation", map[string]interface{}{
		"relationship_id":   relationship.ID,
		"relationship_type": relationship.RelationshipType,
	})

	return nil
}

// GetRelationshipTypeImpactAnalysis performs impact analysis for relationship types
func (n *RelationshipTypesNeo4jIntegration) GetRelationshipTypeImpactAnalysis(ctx context.Context, relationshipType string, depth int) (map[string]interface{}, error) {
	session := n.driver.NewSession(ctx, neo4j.SessionConfig{AccessMode: neo4j.AccessModeRead})
	defer session.Close(ctx)

	// Get downstream impact
	downstreamQuery := `
		MATCH (ci:ConfigurationItem)-[%s*1..%d]->(related:ConfigurationItem)
		WHERE ci.id = $center_id
		RETURN related.id as id, related.name as name, related.ci_type as type,
		       length(shortestPath((ci)-[%s*]->(related))) as depth
		ORDER BY depth ASC
	`

	formattedDownstream := fmt.Sprintf(downstreamQuery, strings.ToUpper(relationshipType), depth, strings.ToUpper(relationshipType))

	// Get upstream impact
	upstreamQuery := `
		MATCH (ci:ConfigurationItem)<-[%s*1..%d]-(related:ConfigurationItem)
		WHERE ci.id = $center_id
		RETURN related.id as id, related.name as name, related.ci_type as type,
		       length(shortestPath((ci)<-[%s*]-(related))) as depth
		ORDER BY depth ASC
	`

	formattedUpstream := fmt.Sprintf(upstreamQuery, strings.ToUpper(relationshipType), depth, strings.ToUpper(relationshipType))

	// For now, return a simple impact analysis structure
	// In a full implementation, you would execute these queries and aggregate results
	return map[string]interface{}{
		"relationship_type": relationshipType,
		"depth":            depth,
		"analysis_type":    "impact_analysis",
	}, nil
}

// Helper methods

func (n *RelationshipTypesNeo4jIntegration) createRelationshipTypeConstraints(ctx context.Context, relationshipType string) {
	session := n.driver.NewSession(ctx, neo4j.SessionConfig{AccessMode: neo4j.AccessModeSchema})
	defer session.Close(ctx)

	// Create uniqueness constraint for relationship IDs
	constraintQuery := fmt.Sprintf("CREATE CONSTRAINT relationship_%s_id_unique IF NOT EXISTS FOR ()-[r:%s]-() REQUIRE r.id IS UNIQUE", relationshipType, strings.ToUpper(relationshipType))

	_, err := session.Run(ctx, constraintQuery, map[string]interface{}{})
	if err != nil {
		n.logger.ErrorService("neo4j", "create_constraint", err, map[string]interface{}{
			"relationship_type": relationshipType,
		})
	}
}

func (n *RelationshipTypesNeo4jIntegration) checkCircularDependencyInNeo4j(ctx context.Context, relationshipType string, sourceID, targetID uuid.UUID, validation *RelationshipTypeValidation) error {
	session := n.driver.NewSession(ctx, neo4j.SessionConfig{AccessMode: neo4j.AccessModeRead})
	defer session.Close(ctx)

	// Check for paths from target back to source (potential cycles)
	query := `
		MATCH path = (target:ConfigurationItem {id: $target_id})-[%s*]->(source:ConfigurationItem {id: $source_id})
		WHERE length(path) > 0
		RETURN count(path) as cycle_count
	`

	formattedQuery := fmt.Sprintf(query, strings.ToUpper(relationshipType))
	params := map[string]interface{}{
		"target_id": targetID.String(),
		"source_id": sourceID.String(),
	}

	result, err := session.Run(ctx, formattedQuery, params)
	if err != nil {
		return fmt.Errorf("failed to check circular dependency: %w", err)
	}

	if result.Next(ctx) {
		cycleCount, _ := result.Record().Get("cycle_count")
		if count, ok := cycleCount.(int64); ok && count > 0 {
			validation.Warnings = append(validation.Warnings, "Potential circular dependency detected")
		}
	}

	return nil
}

// RelationshipTypeNeo4jStats provides Neo4j-specific statistics for relationship types
type RelationshipTypeNeo4jStats struct {
	Name            string                 `json:"name"`
	DisplayName     string                 `json:"display_name"`
	TotalNodes      int64                  `json:"total_nodes"`
	TotalEdges      int64                  `json:"total_edges"`
	AverageDegree   float64                `json:"average_degree"`
	Density         float64                `json:"density"`
	Cycles          int64                  `json:"cycles"`
	Islands         int64                  `json:"islands"`
	LargestComponentSize int64            `json:"largest_component_size"`
}

// GetRelationshipTypeGraphStats gets graph statistics for a relationship type
func (n *RelationshipTypesNeo4jIntegration) GetRelationshipTypeGraphStats(ctx context.Context, relationshipType string) (*RelationshipTypeNeo4jStats, error) {
	session := n.driver.NewSession(ctx, neo4j.SessionConfig{AccessMode: neo4j.AccessModeRead})
	defer session.Close(ctx)

	stats := &RelationshipTypeNeo4jStats{
		Name:        relationshipType,
		DisplayName: relationshipType, // This would be fetched from metadata
	}

	// Get basic statistics
	query := `
		MATCH (ci:ConfigurationItem)
		OPTIONAL MATCH (ci1:ConfigurationItem)-[r:%s]->(ci2:ConfigurationItem)
		RETURN count(DISTINCT ci) as total_nodes,
		       count(r) as total_edges
	`

	formattedQuery := fmt.Sprintf(query, strings.ToUpper(relationshipType))
	result, err := session.Run(ctx, formattedQuery, map[string]interface{}{})
	if err != nil {
		return nil, fmt.Errorf("failed to get graph statistics: %w", err)
	}

	if result.Next(ctx) {
		record := result.Record()
		totalNodes, _ := record.Get("total_nodes")
		totalEdges, _ := record.Get("total_edges")

		stats.TotalNodes = totalNodes.(int64)
		stats.TotalEdges = totalEdges.(int64)

		// Calculate average degree
		if stats.TotalNodes > 0 {
			stats.AverageDegree = float64(2*stats.TotalEdges) / float64(stats.TotalNodes)
		}

		// Calculate density (simplified)
		if stats.TotalNodes > 1 {
			maxPossibleEdges := stats.TotalNodes * (stats.TotalNodes - 1)
			stats.Density = float64(stats.TotalEdges) / float64(maxPossibleEdges)
		}
	}

	return stats, nil
}