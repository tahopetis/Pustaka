// Benchmark tests

func BenchmarkListRelationshipTypes(b *testing.B) {
	handlers, mockService := setupRelationshipTypeTest()

	testID := uuid.New()
	mockRT := createMockRelationshipType(testID)

	response := &ci.RelationshipTypeListResponse{
		RelationshipTypes: []ci.RelationshipType{*mockRT},
		Page:              1,
		Limit:             20,
		Total:             1,
		TotalPages:        1,
	}

	filter := ci.RelationshipTypeFilter{}
	mockService.On("ListRelationshipTypes", mock.Anything, filter, 1, 20).Return(response, nil).Maybe()

	req := httptest.NewRequest("GET", "/api/v1/relationship-types", nil)

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		w := httptest.NewRecorder()
		handlers.ListRelationshipTypes(w, req)
	}
}