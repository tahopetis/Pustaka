// Test helpers

func setupRelationshipTypeTest() (*RelationshipTypeHandlers, *MockRelationshipTypeService) {
	mockService := &MockRelationshipTypeService{}
	mockLogger := &MockLogger{}
	handler := &Handler{
		logger: mockLogger,
	}

	handlers := NewRelationshipTypeHandlers(handler, mockService)
	return handlers, mockService
}

func createMockRelationshipType(id uuid.UUID) *ci.RelationshipType {
	return &ci.RelationshipType{
		ID:               id,
		Name:             "test_type",
		DisplayName:      "Test Type",
		Description:      stringPtr("A test relationship type"),
		Category:         "test",
		ForwardLabel:     "tests",
		BackwardLabel:    "tested by",
		IsActive:         true,
		IsSystem:         false,
		Cardinality:      "many-to-many",
		AllowedSourceTypes: []string{"Server"},
		AllowedTargetTypes: []string{"Application"},
		CreatedBy:        uuid.New(),
	}
}

func stringPtr(s string) *string {
	return &s
}

// Test cases

func TestCreateRelationshipType(t *testing.T) {
	handlers, mockService := setupRelationshipTypeTest()

	userID := uuid.New()
	testID := uuid.New()

	req := ci.CreateRelationshipTypeRequest{
		Name:             "test_type",
		DisplayName:      "Test Type",
		Description:      stringPtr("A test relationship type"),
		Category:         "test",
		ForwardLabel:     "tests",
		BackwardLabel:    "tested by",
		Cardinality:      "many-to-many",
		AllowedSourceTypes: []string{"Server"},
		AllowedTargetTypes: []string{"Application"},
	}

	mockRT := createMockRelationshipType(testID)
	mockService.On("CreateRelationshipType", mock.Anything, &req, userID).Return(mockRT, nil)

	// Create request body
	reqBody, _ := json.Marshal(req)
	req := httptest.NewRequest("POST", "/api/v1/relationship-types", bytes.NewReader(reqBody))

	// Set up mock context with user ID
	ctx := context.WithValue(req.Context(), "user_id", userID.String())
	req = req.WithContext(ctx)

	w := httptest.NewRecorder()
	handlers.CreateRelationshipType(w, req)

	assert.Equal(t, http.StatusCreated, w.Code)

	var response ci.RelationshipType
	err := json.Unmarshal(w.Body.Bytes(), &response)
	assert.NoError(t, err)
	assert.Equal(t, testID, response.ID)
	assert.Equal(t, "test_type", response.Name)

	mockService.AssertExpectations(t)
}

func TestGetRelationshipType(t *testing.T) {
	handlers, mockService := setupRelationshipTypeTest()

	testID := uuid.New()
	mockRT := createMockRelationshipType(testID)

	mockService.On("GetRelationshipType", mock.Anything, testID).Return(mockRT, nil)

	req := httptest.NewRequest("GET", "/api/v1/relationship-types/"+testID.String(), nil)
	w := httptest.NewRecorder()
	handlers.GetRelationshipType(w, req)

	assert.Equal(t, http.StatusOK, w.Code)

	var response ci.RelationshipType
	err := json.Unmarshal(w.Body.Bytes(), &response)
	assert.NoError(t, err)
	assert.Equal(t, testID, response.ID)

	mockService.AssertExpectations(t)
}

func TestListRelationshipTypes(t *testing.T) {
	handlers, mockService := setupRelationshipTypeTest()

	testID := uuid.New()
	mockRT := createMockRelationshipType(testID)

	response := &ci.RelationshipTypeListResponse{
		RelationshipTypes: []ci.RelationshipType{*mockRT},
		Page:              1,
		Limit:             20,
		Total:             1,
		TotalPages:        1,
	}

	filter := ci.RelationshipTypeFilter{}
	mockService.On("ListRelationshipTypes", mock.Anything, filter, 1, 20).Return(response, nil)

	req := httptest.NewRequest("GET", "/api/v1/relationship-types", nil)
	w := httptest.NewRecorder()
	handlers.ListRelationshipTypes(w, req)

	assert.Equal(t, http.StatusOK, w.Code)

	var listResponse ci.RelationshipTypeListResponse
	err := json.Unmarshal(w.Body.Bytes(), &listResponse)
	assert.NoError(t, err)
	assert.Equal(t, 1, len(listResponse.RelationshipTypes))
	assert.Equal(t, testID, listResponse.RelationshipTypes[0].ID)

	mockService.AssertExpectations(t)
}

func TestUpdateRelationshipType(t *testing.T) {
	handlers, mockService := setupRelationshipTypeTest()

	userID := uuid.New()
	testID := uuid.New()

	req := ci.UpdateRelationshipTypeRequest{
		DisplayName: stringPtr("Updated Test Type"),
		Description: stringPtr("Updated description"),
	}

	mockRT := createMockRelationshipType(testID)
	mockRT.DisplayName = "Updated Test Type"
	mockRT.Description = stringPtr("Updated description")

	mockService.On("UpdateRelationshipType", mock.Anything, testID, &req, userID).Return(mockRT, nil)

	// Create request body
	reqBody, _ := json.Marshal(req)
	req := httptest.NewRequest("PUT", "/api/v1/relationship-types/"+testID.String(), bytes.NewReader(reqBody))

	// Set up mock context with user ID
	ctx := context.WithValue(req.Context(), "user_id", userID.String())
	req = req.WithContext(ctx)

	w := httptest.NewRecorder()
	handlers.UpdateRelationshipType(w, req)

	assert.Equal(t, http.StatusOK, w.Code)

	var response ci.RelationshipType
	err := json.Unmarshal(w.Body.Bytes(), &response)
	assert.NoError(t, err)
	assert.Equal(t, "Updated Test Type", response.DisplayName)

	mockService.AssertExpectations(t)
}

func TestDeleteRelationshipType(t *testing.T) {
	handlers, mockService := setupRelationshipTypeTest()

	userID := uuid.New()
	testID := uuid.New()

	mockService.On("DeleteRelationshipType", mock.Anything, testID, userID).Return(nil)

	req := httptest.NewRequest("DELETE", "/api/v1/relationship-types/"+testID.String(), nil)

	// Set up mock context with user ID
	ctx := context.WithValue(req.Context(), "user_id", userID.String())
	req = req.WithContext(ctx)

	w := httptest.NewRecorder()
	handlers.DeleteRelationshipType(w, req)

	assert.Equal(t, http.StatusNoContent, w.Code)
	assert.Equal(t, 0, w.Body.Len())

	mockService.AssertExpectations(t)
}

func TestValidateRelationship(t *testing.T) {
	handlers, mockService := setupRelationshipTypeTest()

	sourceID := uuid.New()
	targetID := uuid.New()

	validation := &ci.RelationshipTypeValidation{
		IsValid:  true,
		Errors:   []string{},
		Warnings: []string{},
	}

	mockService.On("ValidateRelationship", mock.Anything, "depends_on", sourceID, targetID).Return(validation, nil)

	req := httptest.NewRequest("GET", "/api/v1/relationship-types/validate?relationship_type=depends_on&source_id="+sourceID.String()+"&target_id="+targetID.String(), nil)
	w := httptest.NewRecorder()
	handlers.ValidateRelationship(w, req)

	assert.Equal(t, http.StatusOK, w.Code)

	var response ci.RelationshipTypeValidation
	err := json.Unmarshal(w.Body.Bytes(), &response)
	assert.NoError(t, err)
	assert.True(t, response.IsValid)

	mockService.AssertExpectations(t)
}

func TestGetRelationshipTypeUsage(t *testing.T) {
	handlers, mockService := setupRelationshipTypeTest()

	usage := []ci.RelationshipTypeUsage{
		{
			Name:             "depends_on",
			DisplayName:      "Depends On",
			RelationshipCount: 10,
		},
		{
			Name:             "hosts",
			DisplayName:      "Hosts",
			RelationshipCount: 5,
		},
	}

	mockService.On("GetRelationshipTypeUsage", mock.Anything).Return(usage, nil)

	req := httptest.NewRequest("GET", "/api/v1/relationship-types/usage", nil)
	w := httptest.NewRecorder()
	handlers.GetRelationshipTypeUsage(w, req)

	assert.Equal(t, http.StatusOK, w.Code)

	var response []ci.RelationshipTypeUsage
	err := json.Unmarshal(w.Body.Bytes(), &response)
	assert.NoError(t, err)
	assert.Equal(t, 2, len(response))
	assert.Equal(t, "depends_on", response[0].Name)
	assert.Equal(t, int64(10), response[0].RelationshipCount)

	mockService.AssertExpectations(t)
}

func TestGetRelationshipTypeStatistics(t *testing.T) {
	handlers, mockService := setupRelationshipTypeTest()

	stats := &ci.RelationshipTypeStatistics{
		TotalTypes:  25,
		ActiveTypes: 20,
		SystemTypes:  5,
		CustomTypes:  20,
		Categories: map[string]int64{
			"infrastructure": 10,
			"application":    8,
			"operational":    7,
		},
		CardinalityDistribution: map[string]int64{
			"many-to-many": 15,
			"one-to-many":   8,
			"many-to-one":   2,
		},
	}

	mockService.On("GetRelationshipTypeStatistics", mock.Anything).Return(stats, nil)

	req := httptest.NewRequest("GET", "/api/v1/relationship-types/statistics", nil)
	w := httptest.NewRecorder()
	handlers.GetRelationshipTypeStatistics(w, req)

	assert.Equal(t, http.StatusOK, w.Code)

	var response ci.RelationshipTypeStatistics
	err := json.Unmarshal(w.Body.Bytes(), &response)
	assert.NoError(t, err)
	assert.Equal(t, int64(25), response.TotalTypes)
	assert.Equal(t, int64(20), response.ActiveTypes)
	assert.Equal(t, int64(3), len(response.Categories))

	mockService.AssertExpectations(t)
}

func TestCreateRelationshipType_InvalidRequest(t *testing.T) {
	handlers, _ := setupRelationshipTypeTest()

	// Invalid JSON
	req := httptest.NewRequest("POST", "/api/v1/relationship-types", bytes.NewReader([]byte("invalid json")))
	w := httptest.NewRecorder()
	handlers.CreateRelationshipType(w, req)

	assert.Equal(t, http.StatusBadRequest, w.Code)
}

