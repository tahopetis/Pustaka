    "autoprefixer": "^10.6.2",
    "cypress": "^16.2.1",
    "eslint": "^8.54.0",
    "jsdom": "^23.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "typescript": "^5.2.2",
    "vite": "^8.3.6",
